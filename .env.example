# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.
# These two are the Supabase project URL and the frontend PUBLISHABLE (anon) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for auth redirect callbacks (dev default shown).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY — used by scripts/seed-users.mjs AND by the Next.js server for
# Storage downloads after entitlement checks (watermarked previews / HQ export).
# Never reaches the browser, never committed. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared weak password for MVP demo accounts (change/remove before production).
SEED_HQ_ADMIN_PASSWORD=12345678
SEED_FRANCHISE_ADMIN_PASSWORD=12345678
SEED_OPERATIONS_ADMIN_PASSWORD=12345678
SEED_RECRUITER_PASSWORD=12345678
SEED_EMPLOYER_PASSWORD=12345678
SEED_CANDIDATE_PASSWORD=12345678

# ---------------------------------------------------------------------------
# SERVER-ONLY — used ONLY by the candidate CV/resume autofill parser (never
# reaches the browser, never committed). NEVER prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4.1-mini
# Model for AI CV screening (role-fit reviews). Falls back to OPENAI_RESUME_MODEL.
OPENAI_SCREENING_MODEL=gpt-4.1-mini
# Optional: prepaid OpenAI credit balance in USD for the HQ AI credits remaining estimate.
# OPENAI_PREPAID_BALANCE_USD=10

# ---------------------------------------------------------------------------
# SERVER-ONLY — Zoho Recruit offline-satellite connection.
#
# Leave disabled to preserve the current Shugulika behavior. Enabling this only
# allows an HQ admin to complete OAuth and verify the Zoho organization; record
# synchronization has separate database gates that remain OFF.
#
# In Zoho API Console choose "Server-based Applications" and register:
#   http://localhost:3000/api/integrations/zoho-recruit/callback
# plus the exact production callback URL.
ZOHO_RECRUIT_ENABLED=false
ZOHO_RECRUIT_CLIENT_ID=
ZOHO_RECRUIT_CLIENT_SECRET=
# Generate once with: openssl rand -base64 32
ZOHO_RECRUIT_TOKEN_ENCRYPTION_KEY=
ZOHO_RECRUIT_REDIRECT_URI=http://localhost:3000/api/integrations/zoho-recruit/callback
# Initial authorization DC. The callback safely adopts Zoho's verified DC.
ZOHO_RECRUIT_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Shared secret for Zoho workflow webhook POST /api/integrations/zoho-recruit/webhook
# (Authorization: Bearer or X-Shugulika-Zoho-Webhook-Secret). Zoho does not sign bodies.
# ZOHO_RECRUIT_WEBHOOK_SECRET=
# Shared secret for outbox/inbox/reconcile workers (Authorization: Bearer).
# Falls back to CRON_SECRET when unset. Fail closed if neither is configured.
# ZOHO_RECRUIT_WORKER_SECRET=
# CRON_SECRET=

# Employer payments sandbox (three-way gate; all required for demo paid activation):
#   1. Non-production deployment (VERCEL_ENV !== production, or NODE_ENV when unset)
#   2. EMPLOYER_PAYMENTS_SANDBOX=true
#   3. feature_flags.employer_payments_sandbox_enabled = true in the DB
# Never log card details, credentials, or candidate PII.
# Production paid activation stays disabled until a verified real payment provider is live.
# EMPLOYER_PAYMENTS_SANDBOX=false
